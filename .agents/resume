#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

bin/rails db:prepare

DEFAULT_USER_EMAIL=demo@example.com \
DEFAULT_USER_PASSWORD=password \
  bin/rails runner '
    user = User.find_or_initialize_by(email_address: ENV.fetch("DEFAULT_USER_EMAIL"))
    user.update!(
      first_name: "Demo",
      last_name: "User",
      password: ENV.fetch("DEFAULT_USER_PASSWORD")
    )
  '

echo "The default user is ready."
echo "Log in with demo@example.com / password"
