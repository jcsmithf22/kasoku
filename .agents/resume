#!/usr/bin/env bash
set -euo pipefail

if ! pg_isready -q; then
  echo "Starting PostgreSQL..."
  sudo service postgresql start
fi

if ! redis-cli ping 2>/dev/null | grep -qx PONG; then
  echo "Starting Redis..."
  sudo service redis-server start
fi

DEFAULT_USER_EMAIL=demo@example.com \
DEFAULT_USER_PASSWORD=password \
  bin/rails runner '
    user = User.find_or_initialize_by(email: ENV.fetch("DEFAULT_USER_EMAIL"))
    user.update!(
      name: "Demo User",
      password: ENV.fetch("DEFAULT_USER_PASSWORD")
    )
  '

echo "PostgreSQL, Redis, and the default user are ready."
echo "Log in with demo@example.com / password"
