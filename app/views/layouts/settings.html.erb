<%= content_for :content do %>
  <section class="settings flex gap-8">
    <nav class="w-52 shrink-0 space-y-2">
      <h4 class="font-semibold">Account Settings</h4>
      <%= link_to "Profile", settings_profile_path, class: "block" %>
      <%= link_to "Email", settings_email_path, class: "block" %>
      <%= link_to "Password", settings_password_path, class: "block" %>
      <%= link_to "Account", settings_user_path, class: "block" %>
    </nav>
    <div class="grow">
      <%= yield %>
    </div>
  </section>
<% end %>

<%= render template: "layouts/application" %>
