<div class="panel center margin-block-double">
  <h1>Sorry!</h1>
  <p>Either you are no longer a member, or the space no longer exists.</p>
  <%= link_to root_path, class: "btn btn--link", title: "Back to spaces" do %>
    <%= image_tag "arrow-left.svg", aria: { hidden: true }, size: 24 %>
    <span class="for-screen-reader">Back to spaces</span>
  <% end %>
</div>
