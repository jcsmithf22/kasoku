<%# locals: (space:, todo:) -%>

<% cache todo do %>
  <li id="<%= dom_id todo %>" class="border-radius fill-shade pad-double flex flex-wrap gap justify-space-between align-center" data-controller="modal">
    <div class="flex gap align-center min-width">
      <%= form_with model: [space, todo] do |form| %>
        <%= form.hidden_field :completed, value: !todo.completed %>
        <%= form.button class: "btn btn--small btn--circle btn--todo", title: (todo.completed? ? "Mark as todo" : "Mark as done"), aria: { pressed: todo.completed? } do %>
          <%= image_tag "check.svg", aria: { hidden: true }, size: 24 if todo.completed? %>
          <span class="for-screen-reader"><%= todo.completed? ? "Done" : "Todo" %></span>
        <% end %>
      <% end %>
      <span class="overflow-ellipsis" data-action="dblclick->modal#open">
        <%= todo.name %>
      </span>
    </div>
    <%= button_to space_todo_path(space, todo), method: :delete, class: "btn btn--small btn--negative", title: "Remove" do %>
      <%= image_tag "trash.svg", aria: { hidden: true }, size: 24 %>
      <span class="for-screen-reader">Remove</span>
    <% end %>
    <%= render partial: "todos/modal", locals: { space: space, todo: todo } %>
  </li>
<% end %>
