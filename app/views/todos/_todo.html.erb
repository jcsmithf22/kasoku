<%# locals: (space:, todo:) -%>

<% cache todo do %>
  <li id="<%= dom_id todo %>" data-controller="modal">
    <div>
      <%= form_with model: [space, todo] do |form| %>
        <%= form.hidden_field :completed, value: !todo.completed %>
        <%= form.button do %>
          <%= todo.completed? ? "Done" : "Todo" %>
        <% end %>
      <% end %>
      <span data-action="dblclick->modal#open">
        <%= todo.name %>
      </span>
    </div>
    <%= button_to "Remove", space_todo_path(space, todo), method: :delete %>
    <%= render partial: "todos/modal", locals: { space: space, todo: todo } %>
  </li>
<% end %>
