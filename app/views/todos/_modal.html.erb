<%# locals: (space:, todo:) -%>

<dialog data-modal-target="modal">
  <h3>Edit</h3>
  <%= form_with model: [space, todo] do |form| %>
    <div>
      <%= form.text_field :name, placeholder: "Name", autocomplete: "off" %>
    </div>
    <div>
      <button type="button" data-action="modal#close">Close</button>
      <%= form.submit "Save" %>
    </div>
  <% end %>
</dialog>
