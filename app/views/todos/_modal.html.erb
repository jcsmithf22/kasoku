<%# locals: (space:, todo:) -%>

<dialog class="dialog panel shadow" data-modal-target="modal">
  <h3>Edit</h3>
  <%= form_with model: [space, todo], class: "flex flex-column gap" do |form| %>
    <div>
      <%= form.text_field :name, placeholder: "Name", autocomplete: "off", class: "input" %>
    </div>
    <div class="flex flex-wrap gap justify-end">
      <button type="button" class="btn" title="Close" data-action="modal#close">
        <%= image_tag "x.svg", aria: { hidden: true }, size: 24 %>
        <span class="for-screen-reader">Close</span>
      </button>
      <%= form.submit "Save", class: "btn btn--link" %>
    </div>
  <% end %>
</dialog>
