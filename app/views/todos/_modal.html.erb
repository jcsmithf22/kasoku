<%# locals: (space:, todo:) -%>

<dialog data-modal-target="modal" class="rounded-md p-6 shadow-lg backdrop:bg-black/40">
  <h3 class="font-bold text-lg">Edit</h3>
  <%= form_with model: [space, todo], class: "contents" do |form| %>
    <div class="my-5">
      <%= form.text_field :name, placeholder: "Name", autocomplete: "off", class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 w-full" %>
    </div>
    <div class="flex justify-end gap-2">
      <button class="rounded-md px-3 py-2 bg-gray-100" type="button" data-action="modal#close">Close</button>
      <%= form.submit "Save", class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium cursor-pointer" %>
    </div>
  <% end %>
</dialog>
