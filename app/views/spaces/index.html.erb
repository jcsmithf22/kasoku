<%= turbo_stream_from Current.user %>

<div>
  <h1>Spaces</h1>

  <%= render "new", space: @space %>

  <ul id="spaces" role="list" class="flex flex-column gap-half margin-block txt-align-start">
    <%= render partial: "space", locals: { user: Current.user }, collection: @spaces %>
    <li class="txt-align-center only-child">No spaces yet</li>
  </ul>
</div>
