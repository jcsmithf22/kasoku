<%# locals: (space:) -%>

<div>
  <%= link_to "Back", root_path %>
  <%= link_to "Add member", new_space_member_path(space) if owner?(space) %>
  <%= link_to "Members", space_members_path(space) %>
  <%= link_to "Details", space_details_path(space) %>
  <%= link_to "Leave", users_member_path(space.id, slug: space.slug), data: { turbo_method: :delete } unless owner?(space) %>
  <%= link_to "Delete", space, data: { turbo_method: :delete, turbo_confirm: "Delete this space?" } if owner?(space) %>
</div>
