<%# locals: (space:) -%>

<div class="flex flex-wrap gap-half justify-center margin-block">
  <%= link_to root_path, class: "btn btn--small", title: "Go back" do %>
    <%= image_tag "arrow-left.svg", aria: { hidden: true }, size: 24 %>
    <span class="for-screen-reader">Go back</span>
  <% end %>
  <% if owner?(space) %>
    <%= link_to new_space_member_path(space), class: "btn btn--small btn--link", title: "Add member" do %>
      <%= image_tag "user-plus.svg", aria: { hidden: true }, size: 24 %>
      <span class="for-screen-reader">Add member</span>
    <% end %>
  <% end %>
  <%= link_to space_members_path(space), class: "btn btn--small", title: "Members" do %>
    <%= image_tag "users.svg", aria: { hidden: true }, size: 24 %>
    <span class="for-screen-reader">Members</span>
  <% end %>
  <%= link_to space_details_path(space), class: "btn btn--small", title: "Details" do %>
    <%= image_tag "info.svg", aria: { hidden: true }, size: 24 %>
    <span class="for-screen-reader">Details</span>
  <% end %>
  <% unless owner?(space) %>
    <%= link_to users_member_path(space.id, slug: space.slug), class: "btn btn--small btn--negative", title: "Leave", data: { turbo_method: :delete } do %>
      <%= image_tag "user-minus.svg", aria: { hidden: true }, size: 24 %>
      <span class="for-screen-reader">Leave</span>
    <% end %>
  <% end %>
  <% if owner?(space) %>
    <%= link_to space, class: "btn btn--small btn--negative", title: "Delete", data: { turbo_method: :delete, turbo_confirm: "Delete this space?" } do %>
      <%= image_tag "trash.svg", aria: { hidden: true }, size: 24 %>
      <span class="for-screen-reader">Delete</span>
    <% end %>
  <% end %>
</div>
