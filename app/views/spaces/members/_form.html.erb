<%= form_with model: [space, member], url: space_members_path(space), class: "contents" do |form| %>
  <div class="my-5">
    <%= form.email_field :user, value: member.user&.email_address, placeholder: "Email", class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 w-full" %>
  </div>

  <div class="my-5">
    <%= form.select :role, [%w[Member member], %w[Viewer viewer], %w[Admin admin]], { prompt: "Select role" }, class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 w-full" %>
  </div>

  <%= form.hidden_field :from, value: @back_to_members %>
  <%= form.submit "Add member", class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium cursor-pointer" %>
<% end %>
