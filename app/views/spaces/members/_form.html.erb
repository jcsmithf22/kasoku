<%= form_with model: [space, member], url: space_members_path(space) do |form| %>
  <div>
    <%= form.email_field :user, value: member.user&.email_address, placeholder: "Email" %>
  </div>

  <div>
    <%= form.select :role, [%w[Member member], %w[Viewer viewer], %w[Admin admin]], { prompt: "Select role" } %>
  </div>

  <%= form.hidden_field :from, value: @back_to_members %>
  <%= form.submit "Add member" %>
<% end %>
