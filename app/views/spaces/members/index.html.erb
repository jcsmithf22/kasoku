<%= turbo_stream_from "#{@space.slug}_members" %>

<div class="mx-auto max-w-xl space-y-6">
  <h1 class="font-bold text-4xl">Members</h1>

  <%= render "controls", space: @space %>

  <ul class="space-y-2" id="members">
    <li class="member flex items-center justify-between rounded-md bg-gray-100 py-3 px-4">
      <span><%= @space.owner.full_name %></span>
      <span class="text-xs uppercase tracking-wide text-gray-500">owner</span>
    </li>
    <%= render partial: "member", locals: { space: @space }, collection: @members %>
    <li class="no-members p-4 text-center text-gray-500">No members yet</li>
  </ul>
</div>
