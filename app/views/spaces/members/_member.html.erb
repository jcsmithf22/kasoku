<%# locals: (space:, member:) -%>

<% unless member.owner? %>
  <li id="<%= dom_id member %>">
    <div>
      <span><%= member.user.full_name %></span>
      <span><%= member.role %></span>
    </div>
    <%= button_to "Leave", users_member_path(space.id, slug: space.slug), method: :delete if member.user_id == Current.user.id %>
    <%= button_to "Remove", space_member_path(space, member), method: :delete if owner?(space) %>
  </li>
<% end %>
