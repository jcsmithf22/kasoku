<%# locals: (space:, member:) -%>

<% unless member.owner? %>
  <li id="<%= dom_id member %>" class="member flex items-center gap-2">
    <div class="flex grow items-center justify-between rounded-md bg-gray-100 py-3 px-4">
      <span><%= member.user.full_name %></span>
      <span class="text-xs uppercase tracking-wide text-gray-500"><%= member.role %></span>
    </div>
    <%= button_to "Leave", users_member_path(space.id, slug: space.slug), method: :delete, class: "rounded-md px-3 py-2 bg-yellow-100 hover:bg-yellow-200" if member.user_id == Current.user.id %>
    <%= button_to "Remove", space_member_path(space, member), method: :delete, class: "rounded-md px-3 py-2 bg-red-100 hover:bg-red-200" if owner?(space) %>
  </li>
<% end %>
