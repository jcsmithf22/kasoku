<div class="panel center margin-block-double">
  <h1>Add member</h1>

  <%= render "form", space: @space, member: @member %>

  <%= link_to @space, class: "btn margin-block-start", title: "Return to space" do %>
    <%= image_tag "arrow-left.svg", aria: { hidden: true }, size: 24 %>
    <span class="for-screen-reader">Return to space</span>
  <% end %>
</div>
