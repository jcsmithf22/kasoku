<%# locals: (space:, user:) -%>

<li id="<%= dom_id space %>" class="space rounded-md bg-gray-100 hover:bg-gray-200">
  <%= link_to space, class: "flex items-center justify-between py-3 px-4" do %>
    <span><%= space.name %></span>
    <% if user.id != space.owner_id %>
      <span class="text-xs uppercase tracking-wide text-gray-500"><%= space.my_role(user.id) %></span>
    <% end %>
  <% end %>
</li>
