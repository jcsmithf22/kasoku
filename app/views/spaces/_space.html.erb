<%# locals: (space:, user:) -%>

<li id="<%= dom_id space %>">
  <%= link_to space, class: "panel full-width flex gap justify-space-between align-center" do %>
    <span><%= space.name %></span>
    <% if user.id != space.owner_id %>
      <span class="txt-small txt-subtle"><%= space.my_role(user.id) %></span>
    <% end %>
  <% end %>
</li>
